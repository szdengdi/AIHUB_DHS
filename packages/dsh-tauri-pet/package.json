{
  "name": "dsh-tauri-pet",
  "type": "module",
  "version": "0.1.0",
  "description": "Desktop pet for DeepSeek Harness(AIHub定制版) — toggle, pet selection and a transparent always-on-top window bridged through Tauri invoke.",
  "author": "Hairyf <wwu710632@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-tauri-desk/dsh-tauri-plugins.git"
  },
  "bugs": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins/issues",
  "keywords": [
    "dsh",
    "plugin",
    "dsh-plugin",
    "pet",
    "tauri",
    "desktop",
    "deepseek-harness"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.cjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml",
    "dist",
    "skills"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "dsh-tauri"
      ],
      "external": [
        "dsh-tauri/client"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "nr build",
    "start": "tsx src/index.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@deepseek-ai/dsh-skill-filesystem": "catalog:dsh",
    "dsh-tauri": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh-client-store": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "css-render": "catalog:ui",
    "dsh-tauri-tsdown": "workspace:*",
    "react": "catalog:runtime",
    "tsdown": "catalog:cli"
  }
}
